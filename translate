#!/bin/bash

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  echo "Usage: ./translate <input_file> <target>"
  echo ""
  echo "Arguments:"
  echo "  <input_file>   Path to the source TVL file."
  echo "  <target>       Target model checker: 'tla', 'spin'."
  echo "  --props=...    (Optional) Comma-separated list of properties to generate."
  echo "                 Available: finishing, msg, validity, all (default)."
  echo ""
  echo "Example:"
  echo "  ./translate src/model.tvl out/model.tla tla --props=finishing,validity"
  exit 0
fi

if [ "$#" -lt 2 ]; then
  echo "Error: Not enough arguments provided."
  exit 1
fi

INPUT=$1
TARGET=$2

# Construct output file name
if [[ "$TARGET" == "tla" ]]; then
  EXT="tla"
else
  EXT="pml"
fi
DIR=$(dirname "$INPUT")
BASE=$(basename "$INPUT" .tvl)
OUTPUT="$DIR/${BASE}.${EXT}"

PROPS="all"
if [[ "$4" == --props=* ]]; then
  PROPS="${4#--props=}"
fi

sbt -error "runMain main $INPUT $OUTPUT $TARGET $PROPS"
if [ $? -eq 1 ]; then
  echo "Translation failed."
  exit 1
fi

MAP_PATH="$DIR/${BASE}.map.json"
python3 verifier.py $TARGET $OUTPUT $INPUT $MAP_PATH