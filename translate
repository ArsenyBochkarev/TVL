#!/bin/bash

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  echo "Usage: ./translate <input_file> <output_file> <target>"
  echo ""
  echo "Arguments:"
  echo "  <input_file>   Path to the source TVL file."
  echo "  <output_file>  Path where the generated code will be saved."
  echo "  <target>       Target model checker: 'tla', 'spin'."
  echo "  --props=...    (Optional) Comma-separated list of properties to generate."
  echo "                 Available: finishing, msg, validity, all (default)."
  echo ""
  echo "Example:"
  echo "  ./translate src/model.tvl out/model.tla tla --props=finishing,validity"
  exit 0
fi

if [ "$#" -lt 3 ]; then
  echo "Error: Not enough arguments provided."
  exit 1
fi

INPUT=$1
OUTPUT=$2
TARGET=$3

PROPS="all"
if [[ "$4" == --props=* ]]; then
  PROPS="${4#--props=}"
fi

sbt -error "runMain main $INPUT $OUTPUT $TARGET $PROPS"
if [ $? -eq 1 ]; then
  echo "Translation failed."
  exit 1
fi

if [[ "$TARGET" == "tla" ]]; then
  pcal $OUTPUT
  tlc $OUTPUT
elif [[ "$TARGET" == "spin" ]]; then
  spin -a $OUTPUT
  gcc -O2 pan.c -o pan.out
  ./pan.out -a -f
fi