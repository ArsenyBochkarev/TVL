module Ring

actor R1 {
	choose {
		snt: send L1 to R2
		repeat {
			receive alts {
				L1 from R4 => {
					me: send Stop to R2
					receive Stop from R4
					break
				}
				L2 from R4 => { send L2 to R2 }
				L3 from R4 => { send L3 to R2 }
				L4 from R4 => { send L4 to R2 }
				Stop from R4 => { send Stop to R2; nme: break }
			}
		}
	} or {
		repeat {
			receive alts {
				L1 from R4 => {
					send Stop to R2
					receive Stop from R4
					break
				}
				L2 from R4 => { send L2 to R2 }
				L3 from R4 => { send L3 to R2 }
				L4 from R4 => { send L4 to R2 }
				Stop from R4 => { send Stop to R2; break }
			}
		}
	}
}

actor R2 {
	choose {
		snt: send L2 to R3
		repeat {
			receive alts {
				L1 from R1 => { skip } // Smaller ID is ignored
				L2 from R1 => {
					me: send Stop to R3
					receive Stop from R1
					break
				}
				L3 from R1 => { send L3 to R3 }
				L4 from R1 => { send L4 to R3 }
				Stop from R1 => { send Stop to R3; nme: break }
			}
		}
	} or {
		repeat {
			receive alts {
				L1 from R1 => { send L1 to R3 }
				L2 from R1 => {
					send Stop to R3
					receive Stop from R1
					break
				}
				L3 from R1 => { send L3 to R3 }
				L4 from R1 => { send L4 to R3 }
				Stop from R1 => { send Stop to R3; break }
			}
		}
	}
}

actor R3 {
	choose {
		snt: send L3 to R4
		repeat {
			receive alts {
				L1 from R2 => { skip }
				L2 from R2 => { skip }
				L3 from R2 => {
					me: send Stop to R4
					receive Stop from R2
					break
				}
				L4 from R2 => { send L4 to R4 }
				Stop from R2 => { send Stop to R4; nme: break }
			}
		}
	} or {
		repeat {
			receive alts {
				L1 from R2 => { send L1 to R4 }
				L2 from R2 => { send L2 to R4 }
				L3 from R2 => {
					send Stop to R4
					receive Stop from R2
					break
				}
				L4 from R2 => { send L4 to R4 }
				Stop from R2 => { send Stop to R4; break }
			}
		}
	}
}

actor R4 {
	choose {
		snt: send L4 to R1
		repeat {
			receive alts {
				// Greater ID wins
				L1 from R3 => { skip }
				L2 from R3 => { skip }
				L3 from R3 => { skip }
				L4 from R3 => {
					me: send Stop to R1
					receive Stop from R3
					break
				}
				Stop from R3 => { send Stop to R1; nme: break }
			}
		}
	} or {
		repeat {
			receive alts {
				L1 from R3 => { send L1 to R1 }
				L2 from R3 => { send L2 to R1 }
				L3 from R3 => { send L3 to R1 }
				L4 from R3 => {
					send Stop to R1
					receive Stop from R3
					break
				}
				Stop from R3 => { send Stop to R1; break }
			}
		}
	}
}

specs {
	ltl SingleLeader: "G ((R1.me -> (!R2.me && !R3.me && !R4.me)) && (R2.me -> (!R1.me && !R3.me && !R4.me)) && (R3.me -> (!R1.me && !R2.me && !R4.me)) && (R4.me -> (!R1.me && !R2.me && !R3.me)))";
	ltl LeaderElected: "G ((R1.snt || R2.snt || R3.snt || R4.snt) -> F (R1.me || R2.me || R3.me || R4.me))";
	ltl MaxIdWins: "G (R4.snt -> F R4.me)";
	ltl ProtocolFinishes: "G ((R1.snt || R2.snt || R3.snt || R4.snt) -> F (R1.ACTOR_END && R2.ACTOR_END && R3.ACTOR_END && R4.ACTOR_END))";
}
