module ReliableBroadcast

actor N1 {
    choose {
        // N1 initiates
        snt: send INIT to N2
        send INIT to N3
        send INIT to N4

        send ECHO to N2
        send ECHO to N3
        send ECHO to N4

        // Wait for 2 ECHO's from other nodes (its own already included)
        wait_echos: repeat 2 {
            receive alts {
                ECHO from N2 => { skip }
                ECHO from N3 => { skip }
                ECHO from N4 => { skip }
            }
        }
    } or {
        // N1 does not initiate and acts like a regular node
        n_init: repeat 2 {
            receive alts {
                ECHO from N2 => { skip }
                ECHO from N3 => { skip }
                ECHO from N4 => { skip }
            }
        }
    }
}

actor N2 {
    choose {
        start_echo: receive INIT from N1
        send ECHO to N1
        send ECHO to N3
        send ECHO to N4

        // Wait for 2 ECHO's from other nodes (its own already included)
        wait_echos: repeat 2 {
            receive alts {
                ECHO from N1 => { skip }
                ECHO from N3 => { skip }
                ECHO from N4 => { skip }
            }
        }
    } or {
        wait_echos: repeat 2 {
            receive alts {
                INIT from N1 => { skip }
                ECHO from N1 => { skip }
                ECHO from N3 => { skip }
                ECHO from N4 => { skip }
            }
        }

        send ECHO to N1
        send ECHO to N3
        send ECHO to N4
    }
}

// Analogously to N2
actor N3 {
    choose {
        start_echo: receive INIT from N1
        send ECHO to N1
        send ECHO to N2
        send ECHO to N4

        wait_echos: repeat 2 {
            receive alts {
                ECHO from N1 => { skip }
                ECHO from N2 => { skip }
                ECHO from N4 => { skip }
            }
        }
    } or {
        wait_echos: repeat 2 {
            receive alts {
                INIT from N1 => { skip }
                ECHO from N1 => { skip }
                ECHO from N2 => { skip }
                ECHO from N4 => { skip }
            }
        }

        send ECHO to N1
        send ECHO to N2
        send ECHO to N4
    }
}

// Analogously to N2
actor N4 {
    choose {
        start_echo: receive INIT from N1
        send ECHO to N1
        send ECHO to N2
        send ECHO to N3

        wait_echos: repeat 2 {
            receive alts {
                ECHO from N1 => { skip }
                ECHO from N2 => { skip }
                ECHO from N3 => { skip }
            }
        }
    } or {
        wait_echos: repeat 2 {
            receive alts {
                INIT from N1 => { skip }
                ECHO from N1 => { skip }
                ECHO from N2 => { skip }
                ECHO from N3 => { skip }
            }
        }

        send ECHO to N1
        send ECHO to N2
        send ECHO to N3
    }
}

specs {
    ltl Relay: "G ((N1.ACTOR_END || N2.ACTOR_END || N3.ACTOR_END || N4.ACTOR_END) -> F (N1.ACTOR_END && N2.ACTOR_END && N3.ACTOR_END && N4.ACTOR_END))";
    ltl Correctness: "G (N1.snt -> F (N1.ACTOR_END && N2.ACTOR_END && N3.ACTOR_END && N4.ACTOR_END))";
    ltl Unforgeability: "G (N1.n_init -> G !(N1.ACTOR_END || N2.ACTOR_END || N3.ACTOR_END || N4.ACTOR_END))";
}