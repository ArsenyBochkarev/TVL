module Test

actor R1 {
    receive alts {
        X1 from R3 => { skip }
        X2 from R3 => { skip }
    }
}

actor R2 {
    receive Y1 from R3
    receive Y2 from R3
}

actor R3 {
    parallel {
        receive alts {
            Z1 from R4 => { send X1 to R1 }
            Z2 from R4 => { send X2 to R1 }
        }
    } and {
        send Y1 to R2
        send Y2 to R2
    }
    send Z3 to R4
}

actor R4 {
    choose {
        send Z1 to R3
    } or {
        send Z2 to R3
    }
    receive Z3 from R3
}
