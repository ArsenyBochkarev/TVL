reactiveclass Client (20) {
    knownrebecs {
        Gateway gateway;
    }
    statevars {
        int id;
        boolean ready;
        boolean finished;
    }

    Client(int clientId) {
        self.start(clientId);
    }

    msgsrv start(int clientId) {
        id = clientId;
        ready = false;
        finished = false;
        gateway.pay(id);
    }

    msgsrv ack() {
        ready = true;
    }

    msgsrv lost() {
        if (ready && !finished) {
            gateway.pay(id);
        }
    }

    msgsrv processed() {
        if (ready && !finished) {
            gateway.thanks();
            finished = true;
        }
    }
}

reactiveclass Gateway (20) {
    knownrebecs {
        Broker broker;
    }
    statevars {
        boolean accepted;
        int acknowledgements;
    }

    Gateway() {
        accepted = false;
        acknowledgements = 0;
    }

    msgsrv pay(int client) {
        if (!accepted) {
            accepted = true;
            broker.pay(client);
        }
    }

    msgsrv thanks() {
        if (accepted && acknowledgements < 2) {
            acknowledgements++;
            if (acknowledgements == 2) {
                broker.thanks();
            }
        }
    }
}

reactiveclass Broker (20) {
    knownrebecs {
        Client first;
        Client second;
        PayProcessor processor;
    }
    statevars {
        boolean accepted;
    }

    Broker() {
        accepted = false;
    }

    msgsrv pay(int client) {
        if (!accepted) {
            accepted = true;
            processor.pay(client);
            if (client == 1) {
                first.ack();
            } else {
                second.ack();
            }
        }
    }

    msgsrv lost(int client) {
        if (client == 1) {
            first.lost();
        } else {
            second.lost();
        }
    }

    msgsrv processed(int client) {
        if (client == 1) {
            first.processed();
        } else {
            second.processed();
        }
    }

    msgsrv tryAgain(int client) {
        processor.pay(client);
    }

    msgsrv thanks() {
        processor.thanks();
    }
}

reactiveclass PayProcessor (20) {
    knownrebecs {
        Broker broker;
    }
    statevars {
        boolean finished;
    }

    PayProcessor() {
        finished = false;
    }

    msgsrv pay(int client) {
        if (!finished) {
            int outcome = ?(0, 1, 2);
            if (outcome == 0) {
                broker.lost(client);
            } else if (outcome == 1) {
                broker.tryAgain(client);
            } else {
                broker.processed(client);
            }
        }
    }

    msgsrv thanks() {
        finished = true;
    }
}

main {
    Client client1(gateway):(1);
    Client client2(gateway):(2);
    Gateway gateway(broker):();
    Broker broker(client1, client2, processor):();
    PayProcessor processor(broker):();
}
