reactiveclass R1 (20) {
    knownrebecs {
        R2 next;
    }
    statevars {
        boolean active;
        boolean elected;
        boolean finished;
    }

    R1() {
        self.start();
    }

    msgsrv start() {
        active = ?(true, false);
        elected = false;
        finished = false;
        if (active) {
            next.candidate(1);
        }
    }

    msgsrv candidate(int value) {
        if (!finished && !elected) {
            if (value == 1) {
                elected = true;
                next.stop();
            } else if (!active || value > 1) {
                next.candidate(value);
            }
        }
    }

    msgsrv stop() {
        if (!finished) {
            if (!elected) {
                next.stop();
            }
            finished = true;
        }
    }
}

