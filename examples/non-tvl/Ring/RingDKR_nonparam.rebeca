reactiveclass R1 (20) {
    knownrebecs {
        R2 next;
    }
    statevars {
        int phase;
        int first;
    }

    R1() {
        self.start();
    }

    msgsrv start() {
        phase = 0;
        first = 0;
        next.one(1);
    }

    // 0: candidate; 1: await second; 2: await maximum; 3: relay; 4: done.
    msgsrv one(int value) {
        if (phase == 3) {
            next.one(value);
        } else if (phase == 2 && value == 4) {
            next.win(4);
            phase = 3;
        } else if (phase == 0) {
            if (value == 1) {
                next.win(value);
                phase = 3;
            } else {
                first = value;
                next.two(value);
                phase = 1;
            }
        }
    }

    msgsrv two(int value) {
        if (phase == 3) {
            next.two(value);
        } else if (phase == 1) {
            if (first > 1 && value < first) {
                next.one(first);
                if (first == 4) {
                    phase = 2;
                } else {
                    phase = 0;
                }
            } else {
                phase = 3;
            }
        }
    }

    msgsrv win(int value) {
        if (phase == 0 || phase == 3) {
            next.win(value);
            if (phase == 3) {
                phase = 4;
            } else {
                phase = 3;
            }
        }
    }
}

