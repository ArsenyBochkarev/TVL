reactiveclass A (20) {
    knownrebecs {
        B first;
        C second;
        D third;
    }
    statevars {
        int[3] order;
        boolean[4] pending;
        int position;
        boolean finished;
    }

    A() {
        position = 0;
        finished = false;
        for (int i = 0; i < 4; i++) {
            pending[i] = false;
        }
        self.startTour();
    }

    msgsrv startTour() {
        order[0] = 1;
        order[1] = 2;
        order[2] = 3;
        int chosen = ?(0, 1, 2);
        int swap = order[0];
        order[0] = order[chosen];
        order[chosen] = swap;
        if (?(true, false)) {
            swap = order[1];
            order[1] = order[2];
            order[2] = swap;
        }
        sendToken(order[0]);
    }

    msgsrv token(int source) {
        if (!finished) {
            pending[source] = true;
            advance();
        }
    }

    void advance() {
        while (!finished && pending[order[position]]) {
            pending[order[position]] = false;
            position++;
            if (position == 3) {
                finished = true;

            } else {
                sendToken(order[position]);
            }
        }
    }

    void sendToken(int target) {
        if (target == 1) {
            first.token(0);
        } else if (target == 2) {
            second.token(0);
        } else if (target == 3) {
            third.token(0);
        }
    }
}

reactiveclass B (20) {
    knownrebecs {
        A first;
        C second;
    }
    statevars {
        int parent;
        int waiting;
        boolean started;
        boolean finished;
    }

    B() {
        parent = -1;
        waiting = -1;
        started = false;
        finished = false;
    }

    msgsrv token(int source) {
        if (!finished) {
            if (!started) {
                started = true;
                parent = source;
                if (source == 0) {
                    waiting = 2;
                } else {
                    waiting = 0;
                }
                sendToken(waiting);
            } else if (source == waiting) {
                sendToken(parent);
                finished = true;
            }
        }
    }

    void sendToken(int target) {
        if (target == 0) {
            first.token(1);
        } else if (target == 2) {
            second.token(1);
        }
    }
}

reactiveclass C (20) {
    knownrebecs {
        A first;
        B second;
        D third;
    }
    statevars {
        int[2] order;
        boolean[4] pending;
        int position;
        boolean finished;
        int parent;
        boolean started;
    }

    C() {
        position = 0;
        finished = false;
        for (int i = 0; i < 4; i++) {
            pending[i] = false;
        }
        parent = -1;
        started = false;
    }

    msgsrv token(int source) {
        if (!finished) {
            if (!started) {
                started = true;
                parent = source;
                if (parent == 0) {
                    order[0] = 1;
                    order[1] = 3;
                } else if (parent == 1) {
                    order[0] = 0;
                    order[1] = 3;
                } else {
                    order[0] = 0;
                    order[1] = 1;
                }
                if (?(true, false)) {
                    int swap = order[0];
                    order[0] = order[1];
                    order[1] = swap;
                }
                sendToken(order[0]);
            } else {
                pending[source] = true;
                advance();
            }
        }
    }

    void advance() {
        while (!finished && pending[order[position]]) {
            pending[order[position]] = false;
            position++;
            if (position == 2) {
                finished = true;
                sendToken(parent);
            } else {
                sendToken(order[position]);
            }
        }
    }

    void sendToken(int target) {
        if (target == 0) {
            first.token(2);
        } else if (target == 1) {
            second.token(2);
        } else if (target == 3) {
            third.token(2);
        }
    }
}

reactiveclass D (20) {
    knownrebecs {
        A first;
        C second;
    }
    statevars {
        int parent;
        int waiting;
        boolean started;
        boolean finished;
    }

    D() {
        parent = -1;
        waiting = -1;
        started = false;
        finished = false;
    }

    msgsrv token(int source) {
        if (!finished) {
            if (!started) {
                started = true;
                parent = source;
                if (source == 0) {
                    waiting = 2;
                } else {
                    waiting = 0;
                }
                sendToken(waiting);
            } else if (source == waiting) {
                sendToken(parent);
                finished = true;
            }
        }
    }

    void sendToken(int target) {
        if (target == 0) {
            first.token(3);
        } else if (target == 2) {
            second.token(3);
        }
    }
}

main {
    A a(b, c, d):();
    B b(a, c):();
    C c(a, b, d):();
    D d(a, c):();
}
